# ── User identification ────────────────────────────────────────────────
# Country code + number, digits only. Optional: detected automatically after pairing.
MY_PHONE_NUMBER=""
# Comma-separated JIDs or plain phone numbers allowed to get AI replies.
# Groups: AI replies only when you are @mentioned there. Empty = mentions in any group qualify.
WHITELISTED_JIDS=""
# Treat messages you send in your own "Message yourself" chat as test input
# (the assistant answers there). Handy when you only have one phone.
SELF_CHAT_TEST=false

# ── ElevenLabs voice alerts ────────────────────────────────────────────
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"   # Default: Rachel
ELEVENLABS_MODEL_ID="eleven_flash_v2_5"
VOICE_ALERTS_ENABLED=true
# Without an ElevenLabs key, speak alerts with the built-in Windows/macOS/Linux voice instead.
VOICE_SYSTEM_FALLBACK=true

# ── AI provider: "ollama" | "lmstudio" | "custom" ──────────────────────
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"
AI_MODEL_NAME="llama3:latest"
AI_AUTOREPLY_ENABLED=false   # Off by default for safe manual review
AI_DRAFT_MODE=true           # Show replies for approval before sending

# "custom" provider: any OpenAI-compatible endpoint (your own harness, llama.cpp, vLLM...)
CUSTOM_BASE_URL="http://127.0.0.1:8089/v1"
CUSTOM_API_KEY=""
# ...or a .gguf file / folder of .gguf files. A file is served with llama-server automatically.
CUSTOM_MODEL_PATH=""
LLAMA_SERVER_PATH=""          # e.g. D:\models\llama.cpp\b11695\llama-server.exe
LLAMA_SERVER_PORT=8089
LLAMA_SERVER_ARGS="-c 4096 -ngl 99"

# Optional persona note added to the reply prompt (how you talk, who you are).
AI_PERSONA=""

# ── Speech-to-text (Whisper) ───────────────────────────────────────────
# whisper.cpp server endpoint (optional). If unreachable, the local `whisper` CLI is used.
WHISPER_ENDPOINT="http://127.0.0.1:8080/inference"
WHISPER_CLI="whisper"
WHISPER_MODEL="base"
# Microphone for :dictate (ffmpeg dshow device name on Windows). Empty = first device found.
MIC_DEVICE=""

# ── Local dashboard (QR pairing, status, draft approval) ───────────────
DASHBOARD_PORT=3000
